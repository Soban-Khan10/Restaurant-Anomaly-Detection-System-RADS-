RADS_DATA_DIR=./rads_data
RADS_DB_PATH=./rads_data/rads.db
RADS_API_URL=http://127.0.0.1:8000
RADS_WORKER_URL=http://127.0.0.1:8001
RADS_INTERNAL_TOKEN=change-me-long-random-string
RADS_JWT_SECRET=change-me-another-long-random-string
RADS_MODEL_PATH=./models/v2_960_best.pt
RADS_IMGSZ=960
RADS_DEVICE=auto            # auto | cuda | mps | cpu  (set after the M4 benchmark)
CAM1_RTSP=rtsp://user:pass@192.168.1.64:554/Streaming/Channels/101
CAM2_RTSP=rtsp://user:pass@192.168.1.65:554/Streaming/Channels/101
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
TELEGRAM_BOT_TOKEN=
# E-mail alerts over SMTP (leave SMTP_HOST empty to send no e-mail). Put comments on their own lines.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Dashboard address used for links in alert e-mails, e.g. http://192.168.1.10:5173
RADS_DASHBOARD_URL=
# Attach the evidence snapshot to alert e-mails. Privacy: off by default.
EMAIL_ATTACH_SNAPSHOT=false
